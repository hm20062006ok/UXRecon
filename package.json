{
  "name": "iphone-ux-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "uxr": "tsx src/cli/main.ts",
    "doctor": "tsx src/cli/main.ts doctor",
    "explore": "tsx src/cli/main.ts explore",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "p0:doctor": "tsx spikes/real-device/doctor.ts",
    "p0:probe": "tsx spikes/real-device/probe.ts",
    "p0:appium": "bash spikes/real-device/start-appium.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^5.0.5",
    "appium": "3.8.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "webdriverio": "10.1.0"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
