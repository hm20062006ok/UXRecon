# Copy to .env and keep it local. The spike reads environment variables;
# it does not load this file automatically.
UXR_DEVICE_UDID=YOUR_DEVICE_UDID
UXR_DEVICE_NAME=iPhone
UXR_PLATFORM_VERSION=YOUR_IOS_VERSION

# Use a personal or organization Apple Developer team that is allowed to sign WDA.
UXR_XCODE_ORG_ID=YOUR_TEAM_ID
UXR_XCODE_SIGNING_ID=Apple Development
UXR_WDA_BUNDLE_ID=com.example.WebDriverAgentRunner
UXR_ALLOW_PROVISIONING_DEVICE_REGISTRATION=1

# The default transport-only smoke test uses com.apple.Preferences.
# Set this to the third-party target after the test scope is approved.
UXR_TARGET_BUNDLE_ID=com.apple.Preferences

UXR_APPIUM_HOST=127.0.0.1
UXR_APPIUM_PORT=4723

# P0-T3 is read-only unless both variables below are set explicitly.
# The accessibility id must identify a reversible, side-effect-free navigation control.
UXR_ALLOW_SAFE_TAP=0
UXR_SAFE_TAP_ACCESSIBILITY_ID=
UXR_SAFE_TAP_ITERATIONS=10

